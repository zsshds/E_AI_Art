IMAGE_NAME=e-ai-art
IMAGE_TAG=local

MONGO_ROOT_USER=<replace-with-mongo-root-user>
MONGO_ROOT_PASS=<replace-with-mongo-root-password>
MONGO_APP_USER=<replace-with-mongo-app-user>
MONGO_APP_PASS=<replace-with-mongo-app-password>
MONGO_URI=mongodb://$MONGO_APP_USER:$MONGO_APP_PASS@127.0.0.1:27017/imagegen

RABBITMQ_USER=<replace-with-rabbitmq-user>
RABBITMQ_PASS=<replace-with-rabbitmq-password>
RABBITMQ_URI=amqp://$RABBITMQ_USER:$RABBITMQ_PASS@127.0.0.1:5672/

OPENAI_API_KEY=<replace-with-openai-api-key>
OPENAI_BASE_URL=<replace-with-openai-base-url>
OSS_BUCKET=<replace-with-oss-bucket>
OSS_ENDPOINT=<replace-with-oss-endpoint>
OSS_ACCESS_KEY=<replace-with-oss-access-key>
OSS_SECRET_KEY=<replace-with-oss-secret-key>
JWT_SECRET=<replace-with-jwt-secret>
ADMIN_USER=<replace-with-admin-user>
ADMIN_PASS=<replace-with-admin-password>

WORKER_CONCURRENCY=<replace-with-worker-concurrency>
IMAGE_TASK_TIMEOUT_SECONDS=<replace-with-image-task-timeout-seconds>
IMAGE_REQUEST_TIMEOUT_SECONDS=<replace-with-image-request-timeout-seconds>
TASK_DOWNLOAD_TIMEOUT_SECONDS=<replace-with-task-download-timeout-seconds>
TASK_PROCESSING_TIMEOUT_SECONDS=<replace-with-task-processing-timeout-seconds>
TASK_MAX_RETRY=<replace-with-task-max-retry>
